# Copy to frontend/.env.local. No secrets belong here: the website only reads
# public clinic data and talks to the chat API through the same origin.

# Django backend, reached by the Next.js server (never by the browser directly).
DJANGO_API_URL=http://127.0.0.1:8000

# Slug of the clinic shown on this website (Clinic.slug in the Django admin).
CLINIC_SLUG=demo-clinic

# Public address of this website, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
