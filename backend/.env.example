# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# PostgreSQL
# Local development: a local PostgreSQL server, DB_SSLMODE=disable.
# Supabase: use the "Session pooler" values from
#   Project Settings -> Database -> Connection string, with DB_SSLMODE=require.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Chatbot (local Ollama only; see ARCHITECTURE.md "Chatbot")
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60
CHATBOT_DEFAULT_LANGUAGE=sq
CHATBOT_CONVERSATION_TTL_MINUTES=60
CHATBOT_RETENTION_DAYS=30
